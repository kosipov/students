MYSQL_HOST={{ mysql_container }}
MYSQL_USER={{ vault_students_db_user }}
MYSQL_PASSWORD={{ vault_students_db_password }}
MYSQL_DBNAME=students
GIN_MODE=release
# Релей кампуса: адреса обоих лежат здесь, активный выбирается CAMPUS_RELAY_PROVIDER
# (правится на сервере без редеплоя), запасное значение — campus.relay в config.yml.
CAMPUS_RELAY_PROVIDER={{ campus_relay_provider | default('yandex') }}
CAMPUS_RELAY_URL_YANDEX={{ campus_relay_url_yandex }}
CAMPUS_RELAY_URL_CLOUDRU={{ campus_relay_url }}
CAMPUS_RELAY_SECRET={{ vault_campus_relay_secret }}
